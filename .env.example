# Copy to .env.local and fill with your own values. Never commit real keys.

# Provider backend (Auth + RLS reads). Public anon key — still kept in env,
# never hardcoded, so it can be rotated without rewriting git history.
VITE_PROVIDER_URL="https://your-project.example.com"
VITE_PROVIDER_ANON_KEY="your-public-anon-key"

# Automation backend (webhooks for all writes). Optional override; the app
# has a sane default per environment (see src/lib/config.example.ts).
VITE_AUTOMATION_BASE_URL="https://automation.example.com"
